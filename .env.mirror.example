# Credentials for scripts/mirror-brochures.mjs — copy to .env.mirror and fill in.
#
# .env.mirror is git-ignored by the blanket .env* rule. Keep it that way: it
# holds a live Odoo API key, which is why this script runs locally rather than
# anywhere shared.
#
# The four ODOO_ values are the same ones already set as Supabase function
# secrets. Read them from the Supabase dashboard (Edge Functions → Secrets)
# rather than guessing — ODOO_DB in particular is the Odoo Online subdomain,
# not the full host.

ODOO_URL=https://t3ckgrouponline.odoo.com
ODOO_DB=t3ckgrouponline
ODOO_USERNAME=
ODOO_API_KEY=

# Only needed by the one-off visibility-flip script, not by the mirror.
# NEVER name this VITE_ANYTHING: Vite compiles every VITE_-prefixed variable
# into the browser bundle, and this token authorises rewriting product
# configuration in the live ERP. It belongs here, in a git-ignored file that no
# bundler ever reads.
ODOO_ADMIN_TOKEN=

# Cloudinary. Use a preset dedicated to brochures rather than the one the
# chatbox uploads through, so a later tweak there cannot silently change how
# brochures are named.
#
# The preset must have unique_filename OFF — a random suffix breaks the
# deterministic naming the download path depends on. The script proves this on
# its first upload and stops if the URL does not resolve.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# The folder the preset is configured to write into, if any. Cloudinary
# prepends it to the public id, so the app has to know it too — set the same
# value as VITE_CLOUDINARY_BROCHURE_FOLDER in .env. Leave blank for a preset
# with no folder.
CLOUDINARY_FOLDER=

# Upload ceiling. Cloudinary's free plan refuses raw uploads over 10 MB; raise
# this only if you are on a plan that allows more.
# CLOUDINARY_MAX_BYTES=10485760

# Ghostscript preset used for documents that exceed the ceiling — and only
# those. Anything already under it is uploaded byte-for-byte untouched, and
# Odoo's copy is never modified either way.
#   /ebook  150 dpi — readable fine print, the sane default for datasheets
#   /screen  72 dpi — much smaller, too coarse for small text
# Needs Ghostscript on PATH: winget install ArtifexSoftware.GhostScript
# PDF_QUALITY=/ebook
