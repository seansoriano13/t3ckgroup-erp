# Copy to .env.local (git-ignored by the blanket .env* rule) and fill in the
# three secrets marked below. Everything else here is committed as-is on
# purpose: it's derived entirely from supabase/config.toml's committed
# project_id and default local JWT secret, so it's identical on every
# machine and every fresh `supabase start` — verified by wiping this
# project's Docker volumes entirely and confirming every key below came
# back byte-for-byte unchanged (issue #87). Nothing here needs "run
# `supabase status` and paste the output" — just `supabase start` and go.

VITE_APP_ENV=staging
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# The three secrets below are real credentials, not fixtures — get them from
# whichever password manager the team already uses for this project, not by
# guessing or reusing another project's values.

# Powers scripts/seed-dump.mjs (`pnpm db:seed:dump`) and scripts/db-snapshot.mjs
# staging comparisons. Read-only use only — never written to by anything in
# this repo.
STAGING_DB_URL=

# Powers scripts/db-snapshot.mjs prod comparisons (`pnpm db:check-drift:prod`).
# Nothing in local development writes to production; this exists for the
# same drift-detection script staging uses.
PROD_DB_URL=

# Vercel CLI's own OIDC token, used by `vercel env pull` / `vercel dev` if you
# use those. Not required for `pnpm dev` against the local Supabase stack —
# leave blank if you don't use the Vercel CLI locally.
VERCEL_OIDC_TOKEN=
