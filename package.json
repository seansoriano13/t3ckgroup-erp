        "pdf-lib": "^1.17.1",
        "postgres": "^3.4.9",
        "react": "^19.2.5",
        "react-datepicker": "^9.1.0",
        "react-dom": "^19.2.5",
        "react-draggable": "^4.5.0",
        "react-error-boundary": "^6.1.1",
        "react-hot-toast": "^2.6.0",
        "react-markdown": "^10.1.0",
        "react-router": "^7.14.1",
        "react-select": "^5.10.2",
        "recharts": "^3.8.1",
