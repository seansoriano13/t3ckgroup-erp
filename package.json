{
    "name": "vite-generouted-tailwind-boilerplate",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:staging": "vite --mode staging",
        "build": "vite build",
        "lint": "eslint .",
        "lint:primitives": "node scripts/lint-primitives.mjs",
        "lint:tests": "eslint \"src/test/**/*.{js,jsx}\" \"src/**/*.test.{js,jsx}\"",
        "preview": "vite preview",
        "test": "vitest run",
        "test:unit": "vitest run src/utils src/constants src/lib src/hooks src/test/db src/test/factories",
        "test:integration": "vitest run src/services src/context src/components src/test/pages/approvalSplitView",
        "test:e2e": "vitest run src/test/pages/approvals.e2e",
        "test:db": "supabase db reset --local && vitest run -c vitest.db.config.js",
        "test:db:only": "vitest run -c vitest.db.config.js",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "changelog": "node scripts/add-changelog.mjs",
        "preflight": "node scripts/preflight.mjs",
        "mirror:brochures": "node scripts/mirror-brochures.mjs",
        "db:snapshot:prod": "node scripts/db-snapshot.mjs prod",
        "db:snapshot:staging": "node scripts/db-snapshot.mjs staging",
        "db:snapshot:local": "node scripts/db-snapshot.mjs staging --from-local",
        "db:check-drift:prod": "node scripts/db-snapshot.mjs prod --check",
        "db:check-drift:staging": "node scripts/db-snapshot.mjs staging --check",
        "db:ledger:check": "node scripts/db-ledger-check.mjs",
        "db:policy-diff": "node scripts/policy-diff.mjs",
        "local:start": "supabase start",
        "db:reset": "supabase db reset && pnpm db:seed:restore",
        "db:refresh": "supabase db reset && pnpm db:seed:fresh",
        "db:seed:dump": "node scripts/seed-dump.mjs",
        "db:seed:restore": "node scripts/seed-restore.mjs && node scripts/create-magic-user.mjs",
        "db:seed:fresh": "node scripts/seed-dump.mjs && node scripts/seed-restore.mjs && node scripts/create-magic-user.mjs",
        "local:realtime": "node scripts/local-realtime.mjs",
        "db:seed:snapshot": "node scripts/seed-snapshot.mjs",
        "seed:mock:local": "node scripts/seed-mock-employees.mjs --local",
        "seed:mock:purchasing:local": "node scripts/seed-mock-purchasing.mjs && node scripts/seed-mock-costing.mjs",
        "clean:branches": "node scripts/cleanup-branches.mjs",
        "prepare": "node scripts/install-hooks.mjs"
    },
    "dependencies": {
        "@base-ui/react": "^1.4.0",
        "@dagrejs/dagre": "^3.1.1",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fontsource-variable/geist": "^5.2.8",
        "@generouted/react-router": "^1.20.2",
        "@google/generative-ai": "^0.24.1",
        "@pdf-lib/fontkit": "^1.1.1",
        "@radix-ui/colors": "^3.0.0",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-visually-hidden": "^1.2.11",
        "@react-oauth/google": "^0.13.5",
        "@supabase/supabase-js": "^2.103.0",
        "@tailwindcss/vite": "^4.2.2",
        "@tanstack/react-query": "^5.99.0",
        "@xyflow/react": "^12.11.5",
        "browser-image-compression": "^2.0.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.38.0",
        "geist": "^1.7.2",
        "install": "^0.13.0",
        "jwt-decode": "^4.0.0",
        "lucide-react": "^0.577.0",
        "pdf-lib": "^1.17.1",
        "postgres": "^3.4.9",
        "qrcode": "^1.5.4",
        "react": "^19.2.5",
        "react-datepicker": "^9.1.0",
        "react-dom": "^19.2.5",
        "react-draggable": "^4.5.0",
        "react-error-boundary": "^6.1.1",
        "react-hot-toast": "^2.6.0",
        "react-markdown": "^10.1.0",
        "react-router": "^7.14.1",
        "react-select": "^5.10.2",
        "recharts": "^3.8.1",
        "shadcn": "^4.3.0",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.2",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react-swc": "^4.3.0",
        "@vitest/coverage-v8": "^3.2.7",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.5.0",
        "jsdom": "^30.0.1",
        "msw": "^2.15.0",
        "pg": "^8.23.0",
        "vite": "^7.3.2",
        "vitest": "^3.2.7"
    }
}
