{
    "name": "vite-generouted-tailwind-boilerplate",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "lint:tests": "eslint \"src/test/**/*.{js,jsx}\" \"src/**/*.test.{js,jsx}\"",
        "preview": "vite preview",
        "test": "vitest run",
        "test:unit": "vitest run src/utils src/constants src/lib src/hooks src/test/db src/test/factories",
        "test:integration": "vitest run src/services src/context src/components src/test/pages/approvalSplitView",
        "test:e2e": "vitest run src/test/pages/approvals.e2e",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "mirror:brochures": "node scripts/mirror-brochures.mjs",
        "db:sync-staging": "node scripts/sync-data.mjs"
    },
    "dependencies": {
        "@base-ui/react": "^1.4.0",
