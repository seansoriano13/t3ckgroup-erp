# Ordinary `pnpm dev` gets its Supabase URL from .env.local (the local
# Supabase stack — see AGENTS.md § Local development), which overrides this
# file. These are the fallback used by `pnpm build`/`pnpm preview` and by
# `pnpm dev` before .env.local exists.
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
VITE_ALLOW_TEST_LOGIN=false
VITE_TEST_PASSWORD=

# #167: public half of the VAPID keypair used for desktop push notifications.
# The private half is an edge function secret (VAPID_PRIVATE_KEY), never
# checked in here — see supabase/functions/send-push/index.ts.
VITE_VAPID_PUBLIC_KEY=

# Cloudinary — all uploaded media (task attachments, avatars, SOR note files).
# The preset must be unsigned, and must allow the "auto" resource type so
# non-image attachments (PDF, docs) can be uploaded too.
VITE_CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
VITE_CLOUDINARY_UPLOAD_PRESET=YOUR_UNSIGNED_UPLOAD_PRESET

# Folder the brochure upload preset writes into, if any. Prepended to every
# brochure's public id, so it has to match what scripts/mirror-brochures.mjs
# used (CLOUDINARY_FOLDER in .env.mirror) or every brochure 404s and downloads
# refuse. Empty for the dedicated "brochures" preset, which writes no prefix.
VITE_CLOUDINARY_BROCHURE_FOLDER=
VITE_PDFENDPOINT_API_KEY=
