# Loaded by Vite (and therefore Vitest) when mode === "test".
# These are not real credentials — every request to this host is intercepted by
# the MSW handlers in src/test/msw. A test that escapes the fake will fail
# loudly with a connection error rather than reaching a live project.
VITE_SUPABASE_URL=http://supabase.test
VITE_SUPABASE_ANON_KEY=test-anon-key
VITE_GOOGLE_CLIENT_ID=test-google-client-id
VITE_ALLOW_TEST_LOGIN=false
VITE_TEST_PASSWORD=
VITE_CLOUDINARY_CLOUD_NAME=test-cloud
VITE_CLOUDINARY_UPLOAD_PRESET=test-preset
VITE_CLOUDINARY_BROCHURE_FOLDER=
